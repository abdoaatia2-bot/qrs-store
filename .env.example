# ===== قاعدة البيانات (MySQL) =====
# احصل على رابط جديد بعد تغيير كلمة المرور في TiDB Cloud (أو أي مزود MySQL آخر)
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl={"rejectUnauthorized":true}

# ===== الأمان =====
# ولّد قيمة عشوائية جديدة، مثال: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_SECRET

# ===== هوية التطبيق (اختياري - كان يُستخدم من منصة Manus) =====
VITE_APP_ID=
OWNER_OPEN_ID=
OAUTH_SERVER_URL=

# ===== خدمات Forge (اختياري - إن كنت تستخدم ميزات AI من Manus) =====
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ===== الدفع (Stripe) - إن كنت ستفعّل الدفع الحقيقي =====
STRIPE_SECRET_KEY=

# ===== الخادم =====
PORT=3000
NODE_ENV=production
